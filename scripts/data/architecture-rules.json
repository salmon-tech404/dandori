{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Luật phụ thuộc và kiến trúc Dandori (01_KIEN_TRUC.md mục 3 & RS-ARCH-*)",
  "internalDependencies": {
    "dandori-types": [],
    "dandori-events": ["dandori-types"],
    "dandori-db": ["dandori-types"],
    "dandori-vault": ["dandori-types"],
    "dandori-process": ["dandori-types"],
    "dandori-git": ["dandori-types", "dandori-process"],
    "dandori-agent-port": ["dandori-types"],
    "dandori-agent-adapters": ["dandori-types", "dandori-process", "dandori-agent-port"],
    "dandori-module-api": [
      "dandori-types",
      "dandori-events",
      "dandori-db",
      "dandori-vault",
      "dandori-agent-port",
      "dandori-git",
      "dandori-process"
    ],
    "dandori-registry": [
      "dandori-types",
      "dandori-events",
      "dandori-db",
      "dandori-module-api"
    ],
    "dandori-modules": [
      "dandori-types",
      "dandori-module-api",
      "__pattern:mod-*"
    ],
    "dandori-server": [
      "dandori-types",
      "dandori-events",
      "dandori-db",
      "dandori-vault",
      "dandori-process",
      "dandori-git",
      "dandori-agent-port",
      "dandori-agent-adapters",
      "dandori-module-api",
      "dandori-registry",
      "dandori-modules"
    ],
    "fake-agent": ["dandori-types"],
    "__pattern:mod-*": ["dandori-types", "dandori-module-api"],
    "dandori-e2e": ["*"]
  },
  "forbiddenDirectModDependencies": ["dandori-server"],
  "allowedAnyhowCrates": ["dandori-server", "fake-agent"],
  "forbiddenCrateNames": ["utils", "common", "helpers", "misc", "base", "lib"],
  "requiredReadmes": ["README.md", "crates/README.md", "frontend/README.md", "scripts/README.md", "docs/README.md"],
  "approvedExternalDependencies": [
    "tokio",
    "tokio-util",
    "futures",
    "axum",
    "tower",
    "tower-http",
    "serde",
    "serde_json",
    "sqlx",
    "thiserror",
    "anyhow",
    "tracing",
    "tracing-subscriber",
    "uuid",
    "chrono",
    "ts-rs",
    "argon2",
    "sha2",
    "rand",
    "secrecy",
    "zeroize",
    "aes-gcm",
    "keyring",
    "directories",
    "url",
    "reqwest",
    "croner",
    "tempfile",
    "wiremock",
    "proptest"
  ]
}
